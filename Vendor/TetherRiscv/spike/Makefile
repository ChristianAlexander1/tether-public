# Tether — Track P8 spike build for tetherspike (libriscv harness)
#
# Upstream libriscv builds with CMake; this Makefile mirrors its
# lib/CMakeLists.txt source list so the spike builds with plain GNU make
# (this evaluation host has no cmake installed).
#
# Targets:
#   make                 -> build/tetherspike          (threaded dispatch; the iOS-relevant engine)
#   make MODE=switch     -> build/tetherspike-switch   (word-at-a-time interpreter)
#   make MODE=bintr      -> build/tetherspike-bintr    (binary translation via system compiler)
#
# MODE is sticky per binary; they are independent build dirs.

MODE      ?= threaded
LIBRISCV  := libriscv/lib
GENDIR    := build/gen/$(MODE)
OBJDIR    := build/obj/$(MODE)
BIN       := build/tetherspike$(if $(filter threaded,$(MODE)),,-$(MODE))

CXX       ?= g++
CXXFLAGS  ?= -std=c++20 -O2 -Wall -Wextra -Wno-unused-parameter -pthread
INCLUDES  := -I$(GENDIR) -I$(LIBRISCV)
LDFLAGS   ?= -pthread

# --- libriscv sources (mirror of lib/CMakeLists.txt @ vendored commit) ------
SOURCES := \
  $(LIBRISCV)/libriscv/cpu.cpp \
  $(LIBRISCV)/libriscv/debug.cpp \
  $(LIBRISCV)/libriscv/decode_bytecodes.cpp \
  $(LIBRISCV)/libriscv/decoder_cache.cpp \
  $(LIBRISCV)/libriscv/machine.cpp \
  $(LIBRISCV)/libriscv/machine_defaults.cpp \
  $(LIBRISCV)/libriscv/memory.cpp \
  $(LIBRISCV)/libriscv/memory_elf.cpp \
  $(LIBRISCV)/libriscv/memory_mmap.cpp \
  $(LIBRISCV)/libriscv/memory_rw.cpp \
  $(LIBRISCV)/libriscv/native_libc.cpp \
  $(LIBRISCV)/libriscv/native_threads.cpp \
  $(LIBRISCV)/libriscv/posix/minimal.cpp \
  $(LIBRISCV)/libriscv/posix/signals.cpp \
  $(LIBRISCV)/libriscv/posix/threads.cpp \
  $(LIBRISCV)/libriscv/posix/socket_calls.cpp \
  $(LIBRISCV)/libriscv/serialize.cpp \
  $(LIBRISCV)/libriscv/shared_rodata.cpp \
  $(LIBRISCV)/libriscv/util/crc32c.cpp \
  $(LIBRISCV)/libriscv/rv64i.cpp \
  $(LIBRISCV)/libriscv/linux/system_calls.cpp

ifeq ($(MODE),bintr)
SOURCES += \
  $(LIBRISCV)/libriscv/threaded_dispatch.cpp \
  $(LIBRISCV)/libriscv/threaded_inaccurate_dispatch.cpp \
  $(LIBRISCV)/libriscv/tr_api.cpp \
  $(LIBRISCV)/libriscv/tr_emit.cpp \
  $(LIBRISCV)/libriscv/tr_translate.cpp \
  $(LIBRISCV)/libriscv/tr_compiler.cpp
LDFLAGS += -ldl
SETTINGS_EXTRA := \#define RISCV_BINARY_TRANSLATION 1
else ifeq ($(MODE),switch)
SOURCES += $(LIBRISCV)/libriscv/bytecode_dispatch.cpp
SETTINGS_EXTRA :=
else
SOURCES += \
  $(LIBRISCV)/libriscv/threaded_dispatch.cpp \
  $(LIBRISCV)/libriscv/threaded_inaccurate_dispatch.cpp
SETTINGS_EXTRA := \#define RISCV_THREADED 1
endif

OBJECTS := $(patsubst $(LIBRISCV)/%.cpp,$(OBJDIR)/%.o,$(SOURCES))

.PHONY: all clean
all: $(BIN)

$(BIN): $(OBJECTS) $(OBJDIR)/tetherspike.o $(OBJDIR)/main.o
	$(CXX) $(LDFLAGS) $^ -o $@

# C entry point required by the task spec ("minimal main.c")
$(OBJDIR)/main.o: main.c | build/obj
	@mkdir -p $(OBJDIR)
	$(CC) -std=c11 -O2 -Wall -c main.c -o $@

$(OBJDIR)/tetherspike.o: tetherspike.cpp $(GENDIR)/libriscv_settings.h | build/obj
	@mkdir -p $(OBJDIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c tetherspike.cpp -o $@

$(OBJDIR)/%.o: $(LIBRISCV)/%.cpp $(GENDIR)/libriscv_settings.h | build/obj
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Generate libriscv_settings.h (normally produced by CMake configure_file)
$(GENDIR)/libriscv_settings.h: Makefile
	@mkdir -p $(GENDIR)
	@printf '%s\n' \
	  '#ifndef LIBRISCV_SETTINGS_H' \
	  '#define LIBRISCV_SETTINGS_H' \
	  '/* Generated by spike Makefile (mirrors CMake defaults) */' \
	  '#define RISCV_EXT_A 1' \
	  '#define RISCV_EXT_C 1' \
	  '#define RISCV_EXT_V 1' \
	  '#define RISCV_64I 1' \
	  '#define RISCV_MEMORY_TRAPS 1' \
	  '#define RISCV_FLAT_RW_ARENA 1' \
	  '#define RISCV_VIRTUAL_PAGING 1' \
	  '$(SETTINGS_EXTRA)' \
	  '#define RISCV_VERSION_MAJOR 1' \
	  '#define RISCV_VERSION_MINOR 11' \
	  '#endif' > $@
	@echo "generated $@"

build/obj:
	@mkdir -p build/obj

clean:
	rm -rf build

{
  "default": "guest_elf",
  "browser_openers": [
    "open",
    "xdg-open",
    "gnome-open",
    "kde-open",
    "sensible-browser",
    "wslview"
  ],
  "host_runtimes": [
    {
      "match": "basename",
      "name": "node",
      "handler": "node-mobile"
    },
    {
      "match": "basename",
      "name": "npm",
      "handler": "node-mobile"
    },
    {
      "match": "basename",
      "name": "npx",
      "handler": "node-mobile"
    },
    {
      "match": "basename",
      "name": "claude",
      "handler": "claude-code"
    },
    {
      "match": "basename",
      "name": "python3",
      "handler": "python-embedded"
    },
    {
      "match": "basename",
      "name": "python",
      "handler": "python-embedded"
    },
    {
      "match": "basename",
      "name": "pip3",
      "handler": "python-embedded"
    },
    {
      "match": "basename",
      "name": "pip",
      "handler": "python-embedded"
    },
    {
      "match": "basename",
      "name": "wasm",
      "handler": "wasm3"
    }
  ]
}

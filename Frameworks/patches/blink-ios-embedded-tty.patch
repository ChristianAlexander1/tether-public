diff --git a/blink/devfs.c b/blink/devfs.c
index b869e9f..b777114 100644
--- a/blink/devfs.c
+++ b/blink/devfs.c
@@ -20,6 +20,7 @@
 
 #include <stdlib.h>
 #include <string.h>
+#include <unistd.h>
 
 #include "blink/errno.h"
 #include "blink/hostfs.h"
@@ -58,6 +59,20 @@ static int DevfsReadmountentry(struct VfsDevice *device, char **spec,
   return 0;
 }
 
+static int DevfsOpen(struct VfsInfo *parent, const char *name, int flags,
+                     int mode, struct VfsInfo **output) {
+#ifdef TERMX_EMBEDDED_IOS
+  /* An iOS app cannot make the session PTY its native controlling terminal.
+   * `/dev/tty` therefore fails through Darwin even though fd 0 is the real PTY
+   * slave. Expose that same open file description to the Linux guest; this is
+   * what a controlling-terminal open means for the one embedded Blink session. */
+  if (name && !strcmp(name, "tty") && isatty(STDIN_FILENO)) {
+    return HostfsWrapFd(STDIN_FILENO, true, output);
+  }
+#endif
+  return HostfsOpen(parent, name, flags, mode, output);
+}
+
 struct VfsSystem g_devfs = {.name = "devfs",
                             .nodev = true,
                             .ops = {
@@ -69,7 +84,7 @@ struct VfsSystem g_devfs = {.name = "devfs",
                                 .Readlink = HostfsReadlink,
                                 .Mkdir = HostfsMkdir,
                                 .Mkfifo = HostfsMkfifo,
-                                .Open = HostfsOpen,
+                                .Open = DevfsOpen,
                                 .Access = HostfsAccess,
                                 .Stat = HostfsStat,
                                 .Fstat = HostfsFstat,

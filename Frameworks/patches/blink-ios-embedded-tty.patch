-  return tcgetpgrp(hostinfo->filefd);
+  pid_t result = tcgetpgrp(hostinfo->filefd);
+#ifdef TERMX_EMBEDDED_IOS
+  if (result == -1 && errno == ENOTTY && isatty(hostinfo->filefd)) {
+    return termx_blink_tty_getpgrp();
+  }
+#endif
+  return result;
 }
 
 int HostfsTcsetpgrp(struct VfsInfo *info, pid_t pgrp) {
@@ -1729,7 +1751,13 @@ int HostfsTcsetpgrp(struct VfsInfo *info, pid_t pgrp) {
     return efault();
   }
   hostinfo = (struct HostfsInfo *)info->data;
-  return tcsetpgrp(hostinfo->filefd, pgrp);
+  int result = tcsetpgrp(hostinfo->filefd, pgrp);
+#ifdef TERMX_EMBEDDED_IOS
+  if (result == -1 && errno == ENOTTY && isatty(hostinfo->filefd)) {
+    return termx_blink_tty_setpgrp(pgrp);
+  }
+#endif
+  return result;
 }
 

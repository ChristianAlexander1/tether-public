 #include "blink/vfs.h"
 
+#ifdef TERMX_EMBEDDED_IOS
+/* Supplied by Tether's embedding bridge. Darwin has no controlling-terminal
+ * relationship for an app-owned PTY, so the guest foreground group is kept at
+ * the emulator boundary instead of mutating the iOS application's session. */
+extern pid_t termx_blink_tty_getsid(void);
+extern pid_t termx_blink_tty_getpgrp(void);
+extern int termx_blink_tty_setpgrp(pid_t);
+#endif
+
 #ifndef DISABLE_VFS
 
 struct HostfsDevice {
@@ -1709,7 +1719,13 @@ pid_t HostfsTcgetsid(struct VfsInfo *info) {
     return efault();
   }
   hostinfo = (struct HostfsInfo *)info->data;
-  return tcgetsid(hostinfo->filefd);
+  pid_t result = tcgetsid(hostinfo->filefd);
+#ifdef TERMX_EMBEDDED_IOS
+  if (result == -1 && errno == ENOTTY && isatty(hostinfo->filefd)) {
+    return termx_blink_tty_getsid();
+  }
+#endif
+  return result;
 }
 
 pid_t HostfsTcgetpgrp(struct VfsInfo *info) {
@@ -1719,7 +1735,13 @@ pid_t HostfsTcgetpgrp(struct VfsInfo *info) {
     return efault();

{
  "version": 1,
  "description": "TermX iOS binary wheel index plan (PEP 730 ios_* tags)",
  "primary_index": "https://wheels.termx.dev/ios/simple/",
  "fallback_indexes": [
    "https://pypi.org/simple",
    "https://github.com/hololeap/PyPi-index-aarch64-apple-ios/releases/download/v1.0/index.html"
  ],
  "supported_tags": [
    "ios_13_0_arm64_iphoneos",
    "ios_13_0_arm64_iphonesimulator"
  ],
  "build_pipeline": {
    "tooling": "https://github.com/beeware/mobile-forge",
    "upstream_support": "https://github.com/beeware/Python-Apple-support",
    "notes": "Build wheels with mobile-forge, upload to primary_index using PEP 503 layout. Ship top-20 scientific wheels prebuilt; pip install --index-url for binary deps."
  },
  "pip_example": "pip install --index-url https://wheels.termx.dev/ios/simple/ --extra-index-url https://pypi.org/simple cryptography"
}
